PORT=3001
NODE_ENV=production
FORCE_HTTPS=true
DATA_DIR=data
UPLOAD_DIR=public/uploads

ADMIN_PASSWORD=replace_with_a_strong_password_of_12_or_more_characters
ADMIN_EMAIL=you@example.com
OTP_SECRET=replace_with_a_random_secret_of_at_least_32_characters

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
SMTP_FROM=no-reply@tenasgym.com

TELEGRAM_BOT_TOKEN=replace_with_new_telegram_bot_token
TELEGRAM_CHAT_ID=replace_with_telegram_chat_id
